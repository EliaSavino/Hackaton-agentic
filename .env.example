# Hosted model keys. The code never hardcodes these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LiteLLM model alias used when an agent does not specify one.
LITELLM_MODEL_DEFAULT=local_small

# Agent model behavior: auto checks configured availability, off forces deterministic fallbacks,
# always attempts the selected model and falls back only after call/validation failure.
HACKATHON_AGENT_LLM_MODE=auto
HACKATHON_MODEL_CHECK_TIMEOUT=0.5

# Run mode: full, no_dft, cheap, offline.
HACKATHON_RUN_MODE=cheap

# Local Ollama servers available in the hackathon environment.
OLLAMA_BIG_HOST=localhost
OLLAMA_SMALL_HOST=localhost

# Optional hosted API base URLs or keys for non-OpenAI/Anthropic providers.
HOSTED_API_KEY=
HOSTED_API_BASE=

# Optional OpenRouter routing.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Hackathon Agents

# Optional Snellius-hosted vLLM endpoint.
SNELLIUS_VLLM_ENABLED=false
SNELLIUS_VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
SNELLIUS_VLLM_BASE_URL=http://localhost:8000/v1
SNELLIUS_VLLM_API_KEY=

# Optional Snellius Claude Code gateway. Keep this .env on Snellius and run chmod 600.
SNELLIUS_GATEWAY_MASTER_KEY=
SNELLIUS_HOSTED_API_KEY=
SNELLIUS_HOSTED_ALIAS_ENABLED=true

# Optional local corpus for mechanism literature priors.
MECHANISM_LITERATURE_CORPUS_DIR=

# Optional local RoBrains checkout for Bayesian optimization tools.
ROBRAINS_REPO_PATH=/Users/es/GitHub/RoBrains

# Snellius vLLM (heavy/long-context routing). Disabled by default.
SNELLIUS_VLLM_ENABLED=false
SNELLIUS_VLLM_MODEL=
SNELLIUS_VLLM_BASE_URL=

# Saturn generative molecular design (schwallergroup/saturn). Disabled by
# default; when off (or when SATURN_ENABLED is false) the tool returns a
# deterministic mock so the pipeline stays offline-safe. To run the real model,
# clone the Saturn repo, create its conda env, and point these at it.
SATURN_ENABLED=false
SATURN_REPO=
SATURN_PYTHON=python
SATURN_PRIOR=

# Boltz-2 structural co-folding and predicted binding affinity. Disabled by
# default; when off (or when BOLTZ_ENABLED is false) the tool returns a
# high-fidelity deterministic mock simulation. To run the real model on an HPC
# or locally, set BOLTZ_ENABLED=true and configure its settings.
BOLTZ_ENABLED=false
BOLTZ_EXECUTABLE=boltz
BOLTZ_RUN_MODE=local
BOLTZ_DEVICE=cpu

# HPC location and SLURM defaults for real Saturn/Boltz/REINVENT runs.
# Fill these on the machine where jobs are generated or submitted.
# Auth: set HPC_KEY_PATH for SSH-key login (preferred). For PASSWORD login,
# leave HPC_KEY_PATH empty and set HPC_PASSWORD — the client then uses the
# password only (it will not fall back to an SSH agent/discovered key).
HPC_HOST=
HPC_USER=
HPC_PORT=22
HPC_KEY_PATH=
HPC_PASSWORD=
HPC_HOME=~/Home
HPC_REPO_PATH=
HPC_SCRATCH_PATH=
# SLURM_ACCOUNT is a PROJECT CODE (e.g. eucl123), NOT your login name. Leave it
# empty to use your default project; a value equal to HPC_USER is auto-dropped.
SLURM_ACCOUNT=
# GPU: SLURM_PARTITION=gpu_a100 + SLURM_GPUS=1.
# CPU-only (no GPU budget): SLURM_PARTITION=rome (or genoa) + SLURM_GPUS=0.
SLURM_PARTITION=gpu_a100
SLURM_QOS=
SLURM_TIME=02:00:00
SLURM_GPUS=1
# Cost on shared nodes = max(cpus, mem_MiB/1792). Keep mem <= cpus*1792 MiB.
# For CPU REINVENT on a tight budget, 8 cpus + 14G is cheap and sufficient.
SLURM_CPUS_PER_TASK=4
SLURM_MEM=32G
SLURM_SUBMIT_COMMAND=sbatch
# How often (seconds) to poll SLURM job state in slurm_remote mode.
HPC_POLL_INTERVAL=30

# --- Run Saturn on Snellius as a remote SLURM job -------------------------
# Set SATURN_RUN_MODE=slurm_remote and SATURN_ALLOW_SUBMIT=true (plus HPC_HOST/
# HPC_USER above) to stage the config over SSH, sbatch it, wait, and download
# the generated SMILES. Otherwise Saturn only writes the config/script.
SATURN_RUN_MODE=local
SATURN_ALLOW_SUBMIT=false
SATURN_REMOTE_REPO=          # path to the cloned schwallergroup/saturn on the cluster
SATURN_REMOTE_PYTHON=python  # interpreter inside the Saturn conda env on the cluster
SATURN_REMOTE_PRIOR=         # path to the pretrained Saturn prior on the cluster
SATURN_ENV_ACTIVATE=         # shell lines to activate the Saturn env in the job
SATURN_WORK_DIR=
SATURN_TIMEOUT_SECONDS=1800
SATURN_MAX_RETURN=25

# --- Run REINVENT4 (ADC linker design) on Snellius as a remote SLURM job --
# LinkInvent/staged-learning generation. Set REINVENT_RUN_MODE=slurm_remote and
# REINVENT_ALLOW_SUBMIT=true (plus HPC_HOST/HPC_USER above) to stage the config
# over SSH, sbatch it, wait, and download the generated linkers. Otherwise the
# tool only writes the config/script (and the pipeline returns mock molecules).
REINVENT_ENABLED=false
REINVENT_RUN_MODE=local
REINVENT_ALLOW_SUBMIT=false
REINVENT_DEVICE=cpu                  # use cuda:0 on the GPU cluster
REINVENT_EXECUTABLE=reinvent         # local `reinvent` path (local runs only)
REINVENT_PRIOR_BASE=                 # local dir holding *.prior (local runs only)
REINVENT_REMOTE_EXECUTABLE=reinvent  # `which reinvent` inside the cluster/pod env
REINVENT_REMOTE_PRIOR_BASE=          # dir holding linkinvent.prior on the cluster/pod
REINVENT_ENV_ACTIVATE=               # shell lines to activate the REINVENT env in the job
REINVENT_TIMEOUT_SECONDS=1800

# --- Run REINVENT4 on a rented GPU box over SSH (RunPod/Lambda/VM) ---------
# No scheduler: set REINVENT_RUN_MODE=ssh_remote and the SSH connection below.
# reinvent runs directly as a command on the box; outputs are downloaded back.
# Reuses REINVENT_REMOTE_EXECUTABLE and REINVENT_REMOTE_PRIOR_BASE (use ABSOLUTE
# paths on the box, e.g. /workspace/...).
# IMPORTANT: use the pod's DIRECT-TCP endpoint (real IP + high port), NOT the
# ssh.runpod.io proxy (the proxy has no SFTP -> "Channel closed").
# GPU note: run with --device cuda:0 ONLY if the pod's NVIDIA driver matches the
# image's torch CUDA build. If torch is +cu130 but the driver is <=550 (CUDA 12.4)
# you get "driver too old" -> use --device cpu instead. CPU runs are auto-tuned
# (CUDA hidden + thread cap) and a full autonomous run takes ~5 min.
REINVENT_SSH_HOST=                   # pod DIRECT-TCP IP from the dashboard (not ssh.runpod.io)
REINVENT_SSH_USER=root
REINVENT_SSH_PORT=22                 # the pod's exposed direct-TCP port (not 22 on the proxy)
REINVENT_SSH_KEY=                    # path to the private key you registered
REINVENT_SSH_PASSWORD=               # or a password (leave KEY empty to force it)
REINVENT_REMOTE_WORKDIR=/workspace/reinvent_runs
# Optional: threads for CPU runs on the remote box (default: min(nproc, 16)).
# Set on the POD env if you want to override; capping avoids many-core thrashing.
# REINVENT_CPU_THREADS=16

# --- Run Boltz-2 on Snellius as a remote SLURM job ------------------------
# Set BOLTZ_RUN_MODE=slurm_remote and BOLTZ_ALLOW_SUBMIT=true (plus HPC_HOST/
# HPC_USER above) to stage inputs over SSH, sbatch, wait, and download the
# predicted structures/metrics. BOLTZ_ENV_ACTIVATE holds shell lines that
# activate the Boltz environment inside the job (defaults target Snellius Lmod).
BOLTZ_ALLOW_SUBMIT=false
BOLTZ_ENV_ACTIVATE=
BOLTZ_WORK_DIR=
BOLTZ_TIMEOUT_SECONDS=1800
BOLTZ_SINGLE_SEQUENCE=true

# --- Run Boltz-2 on a rented GPU box over SSH (RunPod/Lambda/VM) -----------
# No scheduler: set BOLTZ_RUN_MODE=ssh_remote. `boltz predict` runs directly on
# the box's GPU; the predicted complex (PDB) + confidence/affinity JSON are
# downloaded back and parsed. Reuses the same pod as REINVENT — the code reads the
# REINVENT_SSH_* connection vars (host/port/user/key) for the box.
# POD SETUP (once): the driver (<=550/CUDA 12.4) needs a cu124 torch, NOT reinvent's
# cu130 build, so use a SEPARATE venv:
#   uv venv --python 3.12 /workspace/boltz_venv
#   source /workspace/boltz_venv/bin/activate
#   uv pip install "torch==2.5.1" --index-url https://download.pytorch.org/whl/cu124
#   uv pip install boltz
# Boltz-2's optimized CUDA kernels (cuequivariance_torch) are usually absent on
# rented pods -> the tool passes --no_kernels (pure-torch fallback; correct, fast
# enough on an H200 for ~250-aa targets). Weights auto-download to BOLTZ_CACHE_DIR.
BOLTZ_ENV_ACTIVATE_SSH=source /workspace/boltz_venv/bin/activate
BOLTZ_REMOTE_WORKDIR=/workspace/boltz_runs
BOLTZ_CACHE_DIR=/workspace/.boltz
